# DroneMobile account credentials (the same login the iOS/Android app uses).
DRONEMOBILE_USERNAME=you@example.com
DRONEMOBILE_PASSWORD=your-dronemobile-password

# DroneMobile's own public Cognito app-client id (not a per-user secret —
# every install of the iOS app uses this same value). See README.md
# "Configuration" for where this was found.
DRONEMOBILE_COGNITO_CLIENT_ID=3l3gtebtua7qft45b4splbeuiu

# Optional fallback hint. The bridge discovers every vehicle on the account
# dynamically via GET /vehicle; this is only used if that call returns empty.
DRONEMOBILE_VEHICLE_ID=

# MQTT broker the bridge publishes to, and the credentials it connects with.
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# Poll cadences (seconds)
FAST_POLL_INTERVAL=60
MED_POLL_INTERVAL=300
SLOW_POLL_INTERVAL=3600
INTER_CALL_DELAY=0.4

# How many days of iot/logs + alert/event history to back-fill into MQTT on
# startup. The API horizon is roughly 365 days.
EVENT_BACKFILL_DAYS=30

HA_DISCOVERY_PREFIX=homeassistant
MQTT_TOPIC_PREFIX=dronemobile
LOG_LEVEL=INFO

# Optional: report uncaught exceptions to a GitHub repo via repository_dispatch
# (see _shared/python-github-error-reporter). Leave both unset
# to disable — this is off by default.
GITHUB_ERROR_TOKEN=
GITHUB_REPO=
GITHUB_ERROR_ENVIRONMENT=production
